# =============================================================================
# LLM — Router mode (default) — secrets stay here
# =============================================================================
QA_AGENT_MODEL_PROFILE=router
LLM_API_KEY=sk-...
LLM_BASE_URL=https://your-router.example/v1

# Fallback model names. After you save from Web UI → Settings, those values
# override these via .cache/ui_preferences.json.
QA_AGENT_RESEARCH_MODEL=moonshotai/kimi-k2.7-code
QA_AGENT_GENERATE_MODEL=openai/gpt-4.1
# QA_AGENT_NANO_MODEL=openai/gpt-4.1-mini
# QA_AGENT_PRO_MODEL=openai/gpt-5

# =============================================================================
# Smart retrieval & routing — defaults; prefer Web UI → Settings
# =============================================================================
QA_AGENT_QUERY_EXPANSION=1
QA_AGENT_TRIAGE=1
QA_AGENT_ESCALATION=1
# QA_AGENT_EMBEDDING_MODEL=text-embedding-3-small
# QA_AGENT_EMBEDDING_BASE_URL=
# QA_AGENT_EMBEDDING_API_KEY=

# Persistence defaults (also editable in Web UI → Settings)
# QA_AGENT_MAX_WRITE_ATTEMPTS=4
# QA_AGENT_MAX_REPROMPTS=8
# QA_AGENT_QUALITY_REFINE_ROUNDS=2

# =============================================================================
# Outline / GitHub / paths — stay in .env (secrets & infra)
# =============================================================================
OUTLINE_API_KEY=ol_api_...
OUTLINE_BASE_URL=https://your-team.getoutline.com/api

GITHUB_TOKEN=ghp_...
GITHUB_REPOS=owner/web,owner/bot
GITHUB_DEFAULT_BRANCH=main

QA_AGENT_OUTPUT_DIR=./output
QA_AGENT_CORPUS_DIR=./corpus
QA_AGENT_GRAPHIFY_OUT=./graphify-out

# Domain profile (optional)
# QA_AGENT_DOMAIN_RULES=./domain_rules.json

# Cost / research budget defaults (also editable in Web UI → Settings)
QA_AGENT_TOKEN_BUDGET=1500
QA_AGENT_MAX_PRS=5
QA_AGENT_PR_SCAN_LIMIT=60
QA_AGENT_MAX_PRS_DEEP=4
QA_AGENT_MAX_DOCS=5
QA_AGENT_MAX_DIFF_LINES=500
