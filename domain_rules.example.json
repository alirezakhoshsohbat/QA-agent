{
  "name": "search-pane (example)",
  "prompt_hint": "Common wire vocabulary for this domain: endpoints such as /api/bot/init and /api/bot/send-message; fields data.filters, search_filters, SearchCriteria, propertyType, priceRange, rooms, baths, municipalities; error codes VALIDATION_ERROR, UNAUTHORIZED, BOT_ACCOUNT_NOT_FOUND. Contract rules: priceRange must be an object with min/max (never a string bucket); a history/BotMessageData message must never carry filter values.",
  "concrete_signals": [
    "\\b(?:data|event)\\.filters\\b",
    "\\bsearch_filters\\b",
    "\\b(?:sanitizeSearchCriteriaFields|sortSearchPaneFields|updateCriteria|useSearchCriteria)\\b",
    "\\bSearchPaneFilterId\\b",
    "\\bSearchCriteria\\b",
    "\\bBotMessageData\\b",
    "\\b(?:send_text|propertyType|priceRange|rooms|baths|municipalities)\\b",
    "\\bVALIDATION_ERROR\\b",
    "\\b(?:UNAUTHORIZED|BOT_ACCOUNT_NOT_FOUND|BOT_SESSION_NOT_READY|BOT_UPSTREAM_ERROR)\\b",
    "\\bSSE\\b",
    "(?i)\\bprofile update\\b",
    "(?i)\\bfilters with (?:unknown|invalid)\\b",
    "(?i)\\b(?:unknown|invalid)\\s+IDs?\\b",
    "(?i)\\bchat message\\b",
    "\\bsend-message\\b",
    "(?i)\\bupstream\\b"
  ],
  "domain_context_terms": [
    "filters",
    "search_filters",
    "SearchPane",
    "SearchCriteria",
    "BFF",
    "profile update",
    "send-message"
  ],
  "forbidden_patterns": [
    {
      "label": "BotMessageData.filters property",
      "pattern": "(?i)BotMessageData\\.filters\\b"
    },
    {
      "label": "History message must not carry filter values",
      "pattern": "(?i)(?:last|assistant)\\s+message\\s+containing\\s+filters\\s*\\{"
    },
    {
      "label": "message containing filters with values",
      "pattern": "(?i)message\\s+containing\\s+filters\\s*\\{[^}]*[\\\"'][\\w.]+[\\\"']\\s*:"
    },
    {
      "label": "priceRange string bucket",
      "message": "Forbidden wire shape: priceRange must be an object with min/max, not a string bucket",
      "pattern": "(?i)[\\\"']priceRange[\\\"']\\s*:\\s*[\\\"'][\\d-]+[\\\"']"
    }
  ],
  "vague_phrases": [
    {
      "label": "processes filters (alone)",
      "pattern": "(?i)\\bprocesses the filters\\b(?!\\s*(array|list|from))"
    }
  ],
